# Public Supabase client keys (safe for Vite / browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# NEVER put SUPABASE_SERVICE_ROLE_KEY in VITE_* or any frontend env.
# Service role is Edge Function / server-only (set via `supabase secrets set`).
